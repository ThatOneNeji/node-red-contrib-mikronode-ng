{
    "name": "node-red-contrib-mikronode-ng",
    "version": "0.1.0",
    "description": "Node-RED node for monitoring MikroTik RouterOS devices (traffic, wifi registration, routes, OVPN clients) via mikronode-ng",
    "keywords": [
        "node-red",
        "node-red-contrib",
        "mikrotik",
        "routeros",
        "mikronode"
    ],
    "author": "ThatOneNeji",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git://github.com/ThatOneNeji/node-red-contrib-mikronode-ng.git"
    },
    "bugs": "https://github.com/ThatOneNeji/node-red-contrib-mikronode-ng/issues",
    "homepage": "https://github.com/ThatOneNeji/node-red-contrib-mikronode-ng#readme",
    "engines": {
        "node": ">=22.9.0"
    },
    "node-red": {
        "nodes": {
            "mikrotik-config": "nodes/mikrotik-config.js",
            "mikrotik-status": "nodes/mikrotik-status.js",
            "mikrotik-traffic": "nodes/mikrotik-traffic.js",
            "mikrotik-wifi-registration": "nodes/mikrotik-wifi-registration.js",
            "mikrotik-routes": "nodes/mikrotik-routes.js",
            "mikrotik-ovpn-client": "nodes/mikrotik-ovpn-client.js"
        }
    },
    "files": [
        "nodes/",
        "NOTICE.md"
    ],
    "scripts": {
        "test": "mocha \"test/*_spec.js\" --reporter spec",
        "test:integration": "mocha \"test/integration/*_spec.js\" --reporter spec --exit",
        "coverage": "nyc npm test",
        "lint": "eslint nodes test"
    },
    "dependencies": {
        "@thatoneneji/mikronode-ng": "^1.4.0"
    },
    "devDependencies": {
        "dotenv": "^16.6.1",
        "eslint": "^9.0.0",
        "mocha": "^10.0.0",
        "node-red": "^4.0.0",
        "node-red-node-test-helper": "^0.3.0",
        "nyc": "^17.0.0",
        "should": "^13.2.3"
    }
}

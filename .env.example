# Copy to .env (gitignored) and fill in real MikroTik test devices to run
# `npm run test:integration` against them. Never commit real values.

# Correct credentials, device reachable.
MIKROTIK_HOST=
MIKROTIK_USER=
MIKROTIK_PASSWORD=
MIKROTIK_TEST_INTERFACE=ether1

# Device reachable, wrong credentials - for exercising login-failure handling.
MIKROTIK_BAD_HOST=
MIKROTIK_BAD_USER=
MIKROTIK_BAD_PASSWORD=

# DNS resolves, nothing listening - for exercising connect-failure handling.
MIKROTIK_DOWN_HOST=
